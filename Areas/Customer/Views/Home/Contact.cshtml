@model WebApplication3.Models.contact
@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_Alayout.cshtml";
}


<section class="section-contact bg1-pattern p-t-90 p-b-113">

<div class="container-xxl py-6">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h1 class="display-5 mb-3">İletişime Geç</h1>
            <p>Bu sayfadan bizimle iletişime geçebilirsiniz. En kısa zamanda dönüş yapılacaktır.</p>
        </div>
        <div class="row g-5 justify-content-center">
            <div class="col-lg-5 col-md-12 wow fadeInUp" data-wow-delay="0.1s">
                <div class="bg-primary text-white d-flex flex-column justify-content-center h-100 p-5">
                    <h5 class="text-white">Telefon Numaramız</h5>
                    <p class="mb-5"><i class="fa fa-phone-alt me-3"></i>+012 345 67890</p>
                    <h5 class="text-white">Email Adresimiz</h5>
                    <p class="mb-5"><i class="fa fa-envelope me-3"></i>info@example.com</p>
                    <h5 class="text-white">Ofis Adresimiz</h5>
                    <p class="mb-5"><i class="fa fa-map-marker-alt me-3"></i>123 Ankara, Türkiye</p>
                    <h5 class="text-white">Takip Et</h5>
                    <div class="d-flex pt-2">
                        <a class="btn btn-square btn-outline-light rounded-circle me-1" href=""><i class="fab fa-twitter"></i></a>
                        <a class="btn btn-square btn-outline-light rounded-circle me-1" href=""><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-square btn-outline-light rounded-circle me-1" href=""><i class="fab fa-youtube"></i></a>
                        <a class="btn btn-square btn-outline-light rounded-circle me-0" href=""><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 col-md-12 wow fadeInUp" data-wow-delay="0.5s">
                <p class="mb-4">Buradan Bizimle İletişime Geçebilirsiniz</p>
                    <form class= asp-action="contact">
                        <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control" type="text" asp-for="name" placeholder="Adı">
                                <span asp-validation-for="name"></span>
                                <label for="name">Adınız</label>

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control" type="text" asp-for="eMail" placeholder="Email">
                                <span asp-validation-for="eMail"></span>
                                <label for="email">E Posta Adresiniz</label>

                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <input class="form-control" type="text" asp-for="telefon" placeholder="Telefon Numarası">
                                <span asp-validation-for="telefon"></span>
                                <label for="subject">Telefon Numaranız</label>

                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea class="form-control" asp-for="mesaj" placeholder="Mesaj"></textarea>
                                <span asp-validation-for="mesaj"></span>
                                <label for="message">Mesajınız</label>

                            </div>
                        </div>
                        <div class="col-12">
                            <button class="form-control btn btn-success" type="submit">Mesaj Gönder</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Contact End -->
<!-- Google Map Start -->
<div class="container-xxl px-0 wow fadeIn" data-wow-delay="0.1s" style="margin-bottom: -6px;">
    <iframe class="w-100" style="height: 450px;"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3001156.4288297426!2d-78.01371936852176!3d42.72876761954724!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4ccc4bf0f123a5a9%3A0xddcfc6c1de189567!2sNew%20York%2C%20USA!5e0!3m2!1sen!2sbd!4v1603794290143!5m2!1sen!2sbd"
            frameborder="0" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
</div>
<!-- Google Map End -->
</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
